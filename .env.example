# GEMINI_API_KEY: Required for Gemini AI Music Discovery calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# YOUTUBE_API_KEY: Optional official Google YouTube Data API v3 key for live public search & trending.
# If omitted or quota exhausted, BitChord seamlessly falls back to curated high-fidelity music catalogue.
YOUTUBE_API_KEY=""

# SUPABASE: Optional configuration for cloud database persistence and Google OAuth.
# If omitted, BitChord works in local guest mode with full LocalStorage persistence.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
PORT="3000"
